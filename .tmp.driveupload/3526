extends Button


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	Globals.Scene = "Start"
	grab_focus()

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	#region AddPlayer
	if Input.is_action_just_released("MouseDown") and "Keyboard" not in Globals.PlayerList and len(Globals.PlayerList) <= 4:
		Globals.Players+= 1
		
		Globals.PlayerList.append("Keyboard")
	elif Input.is_action_just_released("Controller1Select") and "Controller1" not in Globals.PlayerList and len(Globals.PlayerList) <= 4:
		Globals.Players+= 1
		
		Globals.PlayerList.append("Controller1")
	elif Input.is_action_just_released("Controller2Select") and "Controller2" not in Globals.PlayerList and len(Globals.PlayerList) <= 4:
		Globals.Players+= 1
		
		Globals.PlayerList.append("Controller2")
	elif Input.is_action_just_released("Controller3Select") and "Controller3" not in Globals.PlayerList and len(Globals.PlayerList) <= 4:
		Globals.Players+= 1
		
		Globals.PlayerList.append("Controller3")
	elif Input.is_action_just_released("Controller4Select") and "Controller4" not in Globals.PlayerList and len(Globals.PlayerList) <= 4:
		Globals.Players+= 1
		
		Globals.PlayerList.append("Controller4")
	#endregion
	
	#region RemovePlayer
	if Input.is_action_just_released("RMB") and "Keyboard" in Globals.PlayerList:
		Globals.Players+= 1
		Globals.PlayerList.erase("Keyboard")
	elif Input.is_action_just_released("Controller1Back") and "Controller1" in Globals.PlayerList:
		Globals.Players-= 1
		
		Globals.PlayerList.erase("Controller1")
	elif Input.is_action_just_released("Controller2Back") and "Controller2" in Globals.PlayerList:
		Globals.Players-= 1
		
		Globals.PlayerList.erase("Controller2")
	elif Input.is_action_just_released("Controller3Back") and "Controller3"  in Globals.PlayerList:
		Globals.Players-= 1
		
		Globals.PlayerList.erase("Controller3")
	elif Input.is_action_just_released("Controller4Back") and "Controller4" in Globals.PlayerList:
		Globals.Players-= 1
		
		Globals.PlayerList.erase("Controller4")
	
	#endregion
	print(Globals.PlayerList)
func _on_pressed() -> void:
	
	
	
	
	
		
	
	if len(Globals.PlayerList) >= 2:
		get_tree().change_scene_to_file("res://CharSelect.tscn")
	else:
		$"../../Label".show()
		$"../../Timer".start()
	
	


func _on_timer_timeout() -> void:
	$"../../Label".hide()
